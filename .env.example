# -----------------------------------------------------------------------------
# Hardware-Inference Environment Configuration Template
# Copy this file to .env.local to configure your local environment
# -----------------------------------------------------------------------------

# Vite Development Server Port (Default: 5173)
VITE_PORT=5173

# Application Base URL (Leave as / for standard deployments)
VITE_BASE_URL=/

# Optional: Enable verbose calculation debugging in console (true / false)
VITE_DEBUG_CALCULATIONS=false

# Optional: Custom HuggingFace API Token (for fetching live model metadata)
# VITE_HF_API_TOKEN=hf_your_token_here
